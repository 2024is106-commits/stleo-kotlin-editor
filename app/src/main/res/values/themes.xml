<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Steotexteditor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/deep_space_black</item>
        <item name="colorPrimary">@color/primary_accent_purple</item>
        <item name="colorOnSurface">@color/text_off_white</item>
        <item name="android:textColor">@color/text_off_white</item>
        <item name="android:textColorPrimary">@color/text_off_white</item>
        <item name="android:textColorSecondary">@color/icon_tint_soft_white</item>
        <item name="android:statusBarColor">@color/deep_space_black</item>
        <item name="android:navigationBarColor">@color/deep_space_black</item>
        <item name="toolbarStyle">@style/Widget.Steotexteditor.Toolbar</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Steotexteditor.Overflow</item>
        <item name="actionOverflowMenuStyle">@style/DarkPopupMenu</item>
        <item name="android:popupMenuStyle">@style/DarkPopupMenu</item>
    </style>

    <style name="Widget.Steotexteditor.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/deep_space_black</item>
        <item name="titleTextColor">@color/text_off_white</item>
        <item name="android:theme">@style/ThemeOverlay.Steotexteditor.Toolbar</item>
        <item name="popupTheme">@style/DarkPopupMenu</item>
    </style>

    <style name="ThemeOverlay.Steotexteditor.Toolbar" parent="ThemeOverlay.Material3.Dark">
        <item name="android:tint">@color/icon_tint_soft_white</item>
        <item name="android:textColorSecondary">@color/icon_tint_soft_white</item>
        <item name="android:textColorPrimary">@color/text_off_white</item>
        <item name="colorControlNormal">@color/icon_tint_soft_white</item>
        <item name="colorControlActivated">@color/primary_accent_purple</item>
    </style>

    <style name="Widget.Steotexteditor.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/icon_tint_soft_white</item>
    </style>

    <style name="Theme.Steotexteditor.Popup" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/popup_menu_background</item>
        <item name="android:textColor">@color/text_off_white</item>
    </style>

    <style name="TextAppearance.Steotexteditor.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_off_white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.Steotexteditor" parent="Base.Theme.Steotexteditor" />

    <style name="DarkPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">#1A1A2E</item>
        <item name="android:textColor">#E8E8F0</item>
    </style>

    <!-- Splash theme used by SplashActivity -->
    <style name="Theme.SteocodeApp.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
