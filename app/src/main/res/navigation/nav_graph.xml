<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/editorFragment">

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.steo.steotexteditor.ui.EditorFragment"
        android:label="@string/editor_title"
        android:layout="@layout/fragment_editor" />

    <fragment
        android:id="@+id/versionsFragment"
        android:name="com.steo.steotexteditor.ui.VersionsFragment"
        android:label="@string/versions_title"
        android:layout="@layout/fragment_versions">
        <argument
            android:name="file_id"
            app:argType="long" />
    </fragment>
</navigation>
