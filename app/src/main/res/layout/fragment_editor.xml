<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/deep_space_black"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/deep_space_black"
        app:navigationIcon="@drawable/ic_menu_close_clear_cancel"
        app:navigationIconTint="@color/icon_tint_soft_white"
        app:titleTextColor="@color/text_off_white"
        app:popupTheme="@style/DarkPopupMenu"
        app:titleTextAppearance="@style/TextAppearance.Steotexteditor.ToolbarTitle"
        app:menu="@menu/editor_menu" />

    <!-- The actual text editor -->
    <EditText
        android:id="@+id/editorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/editor_canvas_dark"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_off_white"
        android:textSize="14sp"
        android:textCursorDrawable="@drawable/cursor_drawable" />

</LinearLayout>
