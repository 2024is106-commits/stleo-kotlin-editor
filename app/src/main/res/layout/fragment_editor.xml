<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/starfield_background">

    <!-- File Bar (White) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/editor_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnNavToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/button_save_black" />

        <EditText
            android:id="@+id/etFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:text="main.kt"
            android:textColor="@color/button_save_black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/silkscreen"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:gravity="center_vertical" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/cursor_drawable"
            android:backgroundTint="@color/button_save_black" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save"
            android:src="@drawable/ic_baseline_save_24"
            app:tint="@color/button_save_black"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_more_vert_24"
            app:tint="@color/button_save_black" />

    </LinearLayout>

    <!-- Quick Actions Bar (Dark) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#151516"
        android:orientation="horizontal"
        android:divider="?android:attr/dividerVertical"
        android:showDividers="middle">

        <ImageButton
            android:id="@+id/btnUndoQuick"
            android:layout_width="0dp"
                        android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_undo_24"
            app:tint="@color/line_number_gray" />

        <ImageButton
            android:id="@+id/btnRedoQuick"
            android:layout_width="0dp"
                        android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_redo_24"
            app:tint="@color/line_number_gray" />

        <TextView
            android:id="@+id/btnSearchQuick"
            android:layout_width="0dp"
                        android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SEARCH"
            android:textColor="@color/line_number_gray"
            android:textSize="12sp"
            android:fontFamily="@font/silkscreen"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnVersionsQuick"
            android:layout_width="0dp"
                        android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="VERSIONS"
            android:textColor="@color/text_off_white"
            android:background="#3A3A5C"
            android:textSize="12sp"
            android:fontFamily="@font/silkscreen"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnLockQuick"
            android:layout_width="48dp"
                        android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_preview_24"
            app:tint="@color/line_number_gray" />

    </LinearLayout>

    <include layout="@layout/layout_search_bar" />

    <!-- The actual code editor with line numbers and preview -->
    <LinearLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.steo.steotexteditor.ui.view.CodeEditorView
            android:id="@+id/editorView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#111515"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingStart="0dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_off_white"
            android:textSize="14sp"
            android:textCursorDrawable="@drawable/cursor_drawable" />

        <ScrollView
            android:id="@+id/scrollPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="#111118">

            <TextView
                android:id="@+id/previewTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#E8E8F0"
                android:textSize="15sp"
                android:fontFamily="monospace" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
