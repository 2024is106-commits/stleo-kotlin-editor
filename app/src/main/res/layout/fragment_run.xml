<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/starfield_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/editor_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnRunBackToEditor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editor"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/button_save_black" />

        <TextView
            android:id="@+id/tvRunFileName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen"
            android:gravity="center_vertical"
            android:text="Untitled.txt"
            android:textColor="@color/button_save_black"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRunPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/silkscreen"
        android:gravity="center"
        android:letterSpacing="0.076"
        android:padding="24dp"
        android:text="NO RUN OUTPUT TO SHOW YET"
        android:textColor="@color/line_number_gray"
        android:textSize="12sp" />

</LinearLayout>
