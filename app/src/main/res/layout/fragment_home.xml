<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/starfield_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvHomeHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/silkscreen"
        android:text="Ready to write your first line of code LEO?"
        android:textColor="@color/text_off_white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- New File Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNewFile"
            android:layout_width="0dp"
            android:layout_height="162dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/editor_white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/silkscreen"
                    android:gravity="center"
                    android:text="NEW\nFILE"
                    android:textColor="@color/button_save_black"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_baseline_insert_drive_file_24"
                    app:tint="@color/button_save_black" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- New Project Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNewProject"
            android:layout_width="0dp"
            android:layout_height="162dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <!-- Custom background with stroke for unselected card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_outline_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/silkscreen"
                        android:gravity="center"
                        android:text="NEW\nPROJECT"
                        android:textColor="@color/text_off_white"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/ic_baseline_folder_24"
                        app:tint="@color/text_off_white" />

                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.45" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@color/editor_white"
        android:fontFamily="@font/silkscreen"
        android:gravity="center"
        android:text="RECENTLY OPENED"
        android:textColor="@color/button_save_black"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvNoRecentFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:fontFamily="@font/silkscreen"
        android:gravity="center"
        android:letterSpacing="0.076"
        android:text="NO RECENT FILES"
        android:textColor="@color/line_number_gray"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
