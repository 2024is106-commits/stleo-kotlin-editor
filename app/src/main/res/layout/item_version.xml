<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="0dp"
    android:background="@drawable/version_card_background">

    <View
        android:id="@+id/latestAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#FF3045"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/silkscreen"
                android:text="V3"
                android:textColor="#E8E8F0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLatest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/latest_badge_background"
                android:fontFamily="@font/silkscreen"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="LATEST"
                android:textColor="#9A7A8B"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/silkscreen"
                android:text="10M AGO"
                android:textColor="#9A9A9F"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:text="Updated main.kt"
            android:textColor="#E8E8F0"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/diffStatsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdded"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/badge_outline_green"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="+12 LINES"
                android:textColor="#00FF3B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRemoved"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_outline_red"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="-4 LINES"
                android:textColor="#FF3045"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDiff"
                android:layout_width="68dp"
                android:layout_height="42dp"
                android:background="@drawable/card_outline_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="DIFF"
                android:textColor="@color/text_off_white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnRestore"
                android:layout_width="104dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/card_outline_background"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="RESTORE"
                android:textColor="@color/text_off_white"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
