<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/starfield_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen"
            android:letterSpacing="0.08"
            android:text="EXPLORER"
            android:textColor="@color/text_off_white"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnCloseDrawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close explorer"
            android:src="@drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_off_white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSidebarSlot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="monospace"
        android:text="{{ SIDEBAR_FILES_SLOT }}"
        android:textColor="@color/text_off_white"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEW"
            android:background="@drawable/pixel_button_background"
            android:textColor="#DCDCF0"
            android:textAllCaps="true"
            android:fontFamily="@font/silkscreen" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OPEN"
            android:background="@drawable/pixel_button_background"
            android:textColor="#DCDCF0"
            android:textAllCaps="true"
            android:fontFamily="@font/silkscreen" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyRecent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NO FILES TO SHOW YET"
        android:textColor="@color/text_off_white"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
