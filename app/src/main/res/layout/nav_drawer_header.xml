<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/deep_space_black">

    <ImageView
        android:id="@+id/navHeaderLogo"
        android:layout_width="120dp"
        android:layout_height="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="STEOCODE"
        android:src="@drawable/ic_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNewFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEW"
            android:background="@drawable/pixel_button_background"
            android:textColor="#DCDCF0"
            android:textAllCaps="true"
            android:fontFamily="@font/silkscreen" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OPEN"
            android:background="@drawable/pixel_button_background"
            android:textColor="#DCDCF0"
            android:textAllCaps="true"
            android:fontFamily="@font/silkscreen" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyRecent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No recent files yet"
        android:textColor="@color/text_off_white"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>